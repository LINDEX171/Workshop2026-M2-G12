# Variables du service remediator (valeurs factices, à copier en .env pour un lancement hors Docker)
# Nom du service (hostname Docker, label des logs/métriques)
SERVICE_NAME=remediator
# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# URL interne du service auth (token de la transaction de test)
AUTH_URL=http://auth:8000
# URL interne du payment-api (vérification de reprise)
PAYMENT_URL=http://payment-api:8000
