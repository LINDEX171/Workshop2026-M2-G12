# Variables du service remediator (valeurs factices, à copier en .env pour un lancement hors Docker)
SERVICE_NAME=remediator
LOG_LEVEL=INFO
# Vérification de reprise (parcours complet via le WAF)
WAF_URL=https://waf:8443
PAYMENT_URL=http://payment-api:8000
OPERATOR_USERNAME=operator
# Accès Docker restreint (lecture + restart/kill) via le proxy, jamais le socket brut
DOCKER_PROXY_URL=http://docker-socket-proxy:2375
COMPOSE_PROJECT=resilience-g12
# Identification de la signature de l'attaquant
LOKI_URL=http://loki:3100
PROBE_USER_AGENT=ResilienceProbe/1.0
# Signatures légitimes jamais bannies (regex), ex. le load-generator
SIGNATURE_EXCLUDE_REGEX=python-requests.*
FALLBACK_ATTACK_SIGNATURE=ResilienceDoS/1.0
# Playbooks et listes de bannissement (volumes)
PLAYBOOKS_DIR=/app/playbooks
WAF_BANLIST_IP_DIR=/var/lib/waf-banlist
WAF_BANLIST_UA_DIR=/var/lib/waf-banlist-ua
# Vérification de reprise : essais et délai (service en warm-up après redémarrage)
VERIFY_ATTEMPTS=12
VERIFY_DELAY_SEC=2.0
# Secret lu dans /run/secrets/ (jamais ici) : operator_password
