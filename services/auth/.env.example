# Variables du service auth (valeurs factices, à copier en .env pour un lancement hors Docker)
# Nom du service (hostname Docker, label des logs/métriques)
SERVICE_NAME=auth
# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Algorithme de signature JWT
JWT_ALG=HS256
# Durée de vie d'un token (minutes)
JWT_EXPIRE_MIN=30
# Base dédiée à auth (réseau auth-data)
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=5432
AUTH_DB_NAME=authdb
AUTH_DB_USER=authuser
# Utilisateurs créés au démarrage (mots de passe = secrets operator_password / admin_password)
OPERATOR_USERNAME=operator
ADMIN_USERNAME=admin
# Secrets lus dans /run/secrets/ (jamais ici) : authuser_password, jwt_secret, operator_password, admin_password
