# Variables du service auth (valeurs factices, à copier en .env pour un lancement hors Docker)
# Nom du service (hostname Docker, label des logs/métriques)
SERVICE_NAME=auth
# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# Algorithme de signature JWT
JWT_ALG=HS256
# Durée de vie d'un token (minutes)
JWT_EXPIRE_MIN=30
# La clé JWT réelle vient de SOPS (/run/secrets/jwt_secret), jamais d'ici
