# Variables du service detector (valeurs factices, à copier en .env pour un lancement hors Docker)
# Nom du service (hostname Docker, label des logs/métriques)
SERVICE_NAME=detector
# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# API HTTP de Prometheus (source des features)
PROMETHEUS_URL=http://prometheus:9090
# Destination des alertes
REMEDIATOR_URL=http://remediator:8000
# Période de calcul du score (s)
DETECTOR_INTERVAL_SEC=10
# Score au-delà duquel on alerte
DETECTOR_THRESHOLD=0.65
# Services sondés par l'agrégateur /status (tableau de bord)
AUTH_URL=http://auth:8000
PAYMENT_URL=http://payment-api:8000
ASSISTANT_URL=http://assistant:8000
# Durée (s) d'affichage de l'état « APRÈS » après une reprise
STATUS_AFTER_WINDOW_SEC=300
