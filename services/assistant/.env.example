# Variables du service assistant (valeurs factices, à copier en .env pour un lancement hors Docker)
SERVICE_NAME=assistant
LOG_LEVEL=INFO
# Ollama (de préférence sur le PC délestage IA)
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text
# Documentation indexée (lecture seule) et base vectorielle persistante
KNOWLEDGE_DIR=/app/knowledge
CHROMA_DIR=/tmp/chroma
# Découpage RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4
