# Variables du service assistant (valeurs factices, à copier en .env pour un lancement hors Docker)
# Nom du service (hostname Docker, label des logs/métriques)
SERVICE_NAME=assistant
# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# URL du serveur Ollama (idéalement sur le PC délestage IA)
OLLAMA_URL=http://ollama:11434
# Modèle <= 8 Md de paramètres
OLLAMA_MODEL=qwen2.5:3b
