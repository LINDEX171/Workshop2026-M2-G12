# Variables du service payment-api (valeurs factices, à copier en .env pour un lancement hors Docker)
# Nom du service (hostname Docker, label des logs/métriques)
SERVICE_NAME=payment-api
# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# URL interne du service auth
AUTH_URL=http://auth:8000
# Le mot de passe DB réel vient de SOPS (/run/secrets/pg_password)
