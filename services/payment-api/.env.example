# Variables du service payment-api (valeurs factices, à copier en .env pour un lancement hors Docker)
# Nom du service (hostname Docker, label des logs/métriques)
SERVICE_NAME=payment-api
# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
# URL interne du service auth
AUTH_URL=http://auth:8000
# Base des paiements (réseau data), rôle applicatif à droits limités
DB_HOST=db
DB_PORT=5432
DB_NAME=payments
DB_USER=payuser
# Compte débité quand la requête ne précise pas `src`
DEFAULT_SRC_ACCOUNT=1
# Secret lu dans /run/secrets/ (jamais ici) : payuser_password
