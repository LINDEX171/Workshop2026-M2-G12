# --- Environnement & secrets (jamais en clair) ---
.env
*.env
!.env.example
!secrets/*.enc.env
*.key
*.pem
age.txt
keys.txt
secrets/*.dec*

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# --- Node / Frontend ---
node_modules/
frontend/dist/

# --- Modèle ML (régénéré via scripts/train_model.sh) ---
services/detector/model/*.pkl

# --- Données locales / volumes ---
data/
volumes/
services/assistant/chroma/
*.dump
*.sql.gz

# --- Divers ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Secrets de dev temporaires (Phase 1, remplacés par SOPS en Phase 10) ---
secrets/*.txt

# --- Certificat TLS du WAF (généré par scripts/gen_cert.sh) ---
infra/waf/certs/*
!infra/waf/certs/.gitkeep

# --- IP bannies par la remédiation (état local, pas versionné) ---
infra/waf/banlist/*.conf
!infra/waf/banlist/00-base.conf
