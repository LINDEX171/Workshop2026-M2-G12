# =====================================================================
# RESILIENCE-ALPHA — G12 — variables NON secrètes
# Copier en .env :  cp .env.example .env
# Les secrets (POSTGRES_PASSWORD, JWT_SECRET...) viennent de
# secrets/secrets.enc.env (SOPS + age), jamais de ce fichier.
# =====================================================================

# --- Global ---
COMPOSE_PROJECT_NAME=resilience-g12   # préfixe des conteneurs/réseaux/volumes
TZ=Europe/Paris                       # fuseau horaire des conteneurs

# --- Postgres (le mot de passe réel vient de SOPS) ---
POSTGRES_USER=payadmin                # super-utilisateur de la base
POSTGRES_DB=payments                  # base principale

# --- JWT (clé réelle via SOPS) ---
JWT_ALG=HS256                         # algorithme de signature des tokens
JWT_EXPIRE_MIN=30                     # durée de vie d'un token (minutes)

# --- Services (URLs internes, jamais localhost entre conteneurs) ---
AUTH_URL=http://auth:8000
PAYMENT_URL=http://payment-api:8000
PROMETHEUS_URL=http://prometheus:9090

# --- Détection ---
DETECTOR_INTERVAL_SEC=10              # période de calcul du score (s)
DETECTOR_THRESHOLD=0.65               # score au-delà duquel on alerte

# --- Remédiation ---
REMEDIATOR_URL=http://remediator:8000

# --- Assistant ---
OLLAMA_URL=http://ollama:11434        # idéalement sur le PC délestage IA
OLLAMA_MODEL=qwen2.5:3b               # modèle <= 8 Md de paramètres
